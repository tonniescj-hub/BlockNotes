{
  "name": "blocknotes",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "description": "A local-first voxel study for your notes",
  "author": "tonniescj-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonniescj-hub/BlockNotes.git"
  },
  "homepage": "https://github.com/tonniescj-hub/BlockNotes#readme",
  "bugs": {
    "url": "https://github.com/tonniescj-hub/BlockNotes/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "check": "tsc --noEmit",
    "audit:source": "node scripts/audit-public-source.mjs --history",
    "build": "npm run check && vite build",
    "start": "electron .",
    "test": "node --test tests/storage.test.mjs tests/models.test.mjs tests/media.test.mjs tests/lighting.test.mjs tests/backup-http.test.mjs tests/public-source.test.mjs tests/resources.test.mjs tests/reading.test.mjs",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --win dir",
    "portable": "npm run build && electron-builder --win portable",
    "pack:local": "npm run build && electron-builder --config electron-builder.local.cjs --win dir",
    "portable:local": "npm run build && electron-builder --config electron-builder.local.cjs --win portable"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cheerio": "1.2.0",
    "docx": "9.15.3",
    "mammoth": "1.13.0",
    "opentype.js": "2.0.0",
    "pdfjs-dist": "6.5.438",
    "pngjs": "7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "2.18.2",
    "stream-json": "3.7.0",
    "three": "^0.180.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.11.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.blocknotes.desktop",
    "productName": "BlockNotes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/minecraft/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "LICENSE",
      "docs/licenses/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "icon": "public/branding/blocknotes.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "BlockNotes-${version}-Windows-${arch}.exe"
    }
  }
}
